# ───── Server ─────
NODE_ENV=development
PORT=4000

# Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Then paste the output here. Required for all /api/* requests from the extension.
SHARED_SECRET=

# ───── Postgres ─────
# Format: postgresql://<user>:<password>@<host>:<port>/<db>
# Example (default local install with postgres superuser):
#   postgresql://postgres:yourpassword@localhost:5432/hired
DATABASE_URL=

# ───── Google (Gmail + Gemini) ─────
# From Google Cloud Console → Credentials → OAuth 2.0 Client ID (Desktop app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# From aistudio.google.com → Get API Key
GEMINI_API_KEY=

# ───── Discovery (SerpAPI) ─────
# From serpapi.com → Dashboard
# Free tier: 250 searches/month, no card required
SERPAPI_API_KEY=

# ───── Email finder (Snov.io) ─────
# From app.snov.io → Account → API tab
# Snov uses OAuth2 client credentials, not a single API key.
# Free tier: 50 credits/month (accepts gmail signup, unlike Hunter)
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=

# ───── Email verifier (Reoon) ─────
# From emailverifier.reoon.com → Dashboard → API
# Free tier: 600 verifications/month
REOON_API_KEY=

# ───── LLM-based discovery (R&D) ─────
# OpenAI API key for the OpenAiDiscoverySource adapter (uses Responses API
# with the built-in web_search tool).
# From platform.openai.com → API keys → Create new secret key
# Cost: ~$5-6/month at 4 discoveries/day (gpt-5.6-luna model + web_search tool).
# Leave blank if you only want to use Gemini (free, uses GEMINI_API_KEY above).
OPENAI_API_KEY=
