{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    // "bundler" matches how tsx and vitest resolve TS files during dev/test.
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*", "scripts/**/*", "test/**/*"],
  "exclude": ["dist", "node_modules"]
}
